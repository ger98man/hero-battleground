# Строка подключения к PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hero_battleground
# Секрет для подписи cookie сессии (любая длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string
# true — если подключаетесь к внешнему URL базы на Render
DATABASE_SSL=false
PORT=3000
NODE_ENV=development
